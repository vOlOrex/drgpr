local function addFloatingParticles(key, container, count, colors, opts)
	opts = opts or {}
	local list = {}
	for i = 1, count do
		local s = math.random(opts.min or 2, opts.max or 3)
		local f = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(s, s),
			BackgroundColor3 = colors[(i % #colors) + 1],
			BackgroundTransparency = 1,
			Parent = container,
		})
		round(f)
		list[i] = {
			f = f,
			x = math.random(),
			y = math.random(),
			sp = (opts.speed or 0.03) * (0.5 + math.random()),
			ph = math.random() * 6.28,
			amp = 0.01 + math.random() * 0.02,
		}
	end
	addStepper(key, function(dt, t)
		for _, p in ipairs(list) do
			p.y = p.y - p.sp * dt
			if p.y < -0.05 then
				p.y = 1.05
				p.x = math.random()
			end
			p.f.Position = UDim2.fromScale(p.x + math.sin(t * 0.8 + p.ph) * p.amp, p.y)
			local edge = math.clamp(math.min(p.y, 1 - p.y) * 4, 0, 1)
			p.f.BackgroundTransparency = 1 - edge * (opts.alpha or 0.6)
		end
	end, true)
	local api = {}
	function api.recolor(cols)
		for i, p in ipairs(list) do
			p.f.BackgroundColor3 = cols[(i % #cols) + 1]
		end
	end
	return api
end

