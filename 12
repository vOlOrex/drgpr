local function matchFruits(query, limit)
	local q = norm(query)
	local res = {}
	if q == "" then
		return res
	end
	for _, f in ipairs(FRUITS) do
		if string.sub(f.Key, 1, #q) == q then
			table.insert(res, f)
		end
	end
	for _, f in ipairs(FRUITS) do
		if string.sub(f.Key, 1, #q) ~= q and string.find(f.Key, q, 1, true) then
			table.insert(res, f)
		end
	end
	while #res > limit do
		table.remove(res)
	end
	return res
end

local function resolveFruit(query)
	local q = norm(query)
	if q == "" then
		return nil
	end
	if FRUIT_BY_KEY[q] then
		return FRUIT_BY_KEY[q]
	end
	local m = matchFruits(query, 1)
	if m[1] and #q >= 2 and string.sub(m[1].Key, 1, #q) == q then
		return m[1]
	end
	return nil
end

