local unlockedFruits = {} -- مثال: unlockedFruits["dragon"] = true
local unlockAllActive = false
local convertedCache = {}

local function norm(s)
	return string.lower((string.gsub(s or "", "[^%w]", "")))
end

-- تحويل السعر إلى (OWNED) بنفس تصميم السكربت الثاني
local function convertToOwned(priceElement)
	if not priceElement or not priceElement.Parent or convertedCache[priceElement] then return end

	local parent = priceElement.Parent
	local parentName = parent.Name:lower()

	if parentName:find("health") or parentName:find("energy") or parentName:find("stat") or 
	   parentName:find("hud") or parentName:find("move") or parentName:find("skill") or 
	   parentName:find("requirement") or parentName:find("fury") or parentName:find("mastery") or
	   parentName:find("level") then
		return
	end

	if priceElement.AbsoluteSize.X < 40 or priceElement.AbsoluteSize.Y < 15 then
		return
	end

	local templateOwnedContainer = nil
	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
			for _, child in ipairs(desc:GetChildren()) do
				if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Text:upper():find("OWNED") then
					templateOwnedContainer = desc
					break
				end
			end
			if templateOwnedContainer then break end
		end
	end

	if templateOwnedContainer then
		if priceElement:FindFirstChild("ClonedOwnedBadge") then
			convertedCache[priceElement] = true
			return
		end

		priceElement.Text = ""
		priceElement.BackgroundTransparency = 1

		for _, child in ipairs(priceElement:GetChildren()) do
			if child.Name ~= "ClonedOwnedBadge" then
				child.Visible = false
			end
		end

		local clonedBadge = templateOwnedContainer:Clone()
		clonedBadge.Name = "ClonedOwnedBadge"
		clonedBadge.Size = UDim2.new(1.02, 0, 1.08, 0)
		clonedBadge.Position = UDim2.new(-0.03, 0, -0.13, 0)
		clonedBadge.AnchorPoint = Vector2.new(0, 0)
		clonedBadge.BackgroundTransparency = 1
		clonedBadge.ImageColor3 = Color3.fromRGB(15, 15, 15)
		clonedBadge.Visible = true
		clonedBadge.ZIndex = priceElement.ZIndex + 5
		clonedBadge.Parent = priceElement

		for _, child in ipairs(clonedBadge:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") then
				child.Text = "(OWNED)"
				child.TextColor3 = Color3.fromRGB(255, 204, 0)
				child.BackgroundTransparency = 1
				child.Visible = true
				child.ZIndex = clonedBadge.ZIndex + 1
			end
		end
	else
		priceElement.Text = "(OWNED)"
		priceElement.TextColor3 = Color3.fromRGB(255, 204, 0)
		priceElement.BackgroundTransparency = 1
		pcall(function() 
			priceElement.Font = Enum.Font.SourceSansBold 
		end)
	end

	if priceElement.Parent then
		for _, sibling in ipairs(priceElement.Parent:GetChildren()) do
			if sibling ~= priceElement and (sibling:IsA("ImageLabel") or sibling:IsA("ImageButton")) then
				local sName = sibling.Name:lower()
				if sName:find("robux") or sName:find("icon") or sName:find("coin") or sName:find("currency") then
					sibling.Visible = false
				end
			end
		end
	end

	convertedCache[priceElement] = true
end

-- التحقق هل السعر ينتمي لفاكهة تم فتحها أم لا
local function shouldConvertFruit(guiElement)
	if unlockAllActive then
		return true
	end

	-- الصعود في شجرة العناصر للبحث عن كارت الفاكهة ومطابقة اسمها
	local card = guiElement.Parent
	for i = 1, 5 do
		if not card or card == playerGui then break end
		
		-- فحص اسم الحاوية نفسها
		local cKey = norm(card.Name)
		for fKey, isUnlocked in pairs(unlockedFruits) do
			if isUnlocked and cKey:find(fKey, 1, true) then
				return true
			end
		end

		-- فحص النصوص الموجودة داخل نفس الكارت (مثل اسم الفاكهة المعروض)
		for _, desc in ipairs(card:GetDescendants()) do
			if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc ~= guiElement then
				local tKey = norm(desc.Text)
				if tKey ~= "" then
					for fKey, isUnlocked in pairs(unlockedFruits) do
						if isUnlocked and (tKey == fKey or tKey:find(fKey, 1, true)) then
							return true
						end
					end
				end
			end
		end

		card = card.Parent
	end

	return false
end

local function isShopPrice(guiElement)
	if not guiElement or convertedCache[guiElement] then return false end
	if not guiElement:IsA("TextLabel") and not guiElement:IsA("TextButton") then return false end
	if guiElement:IsDescendantOf(playerGui:FindFirstChild("FruitVaultUI")) then return false end

	local txt = guiElement.Text
	if not txt or txt == "" or txt:upper():find("OWNED") then return false end

	local cleaned = txt:gsub("%D", "")
	if cleaned ~= "" and tonumber(cleaned) then
		local ancestor = guiElement
		local inSkillsOrHud = false

		for i = 1, 8 do
			if ancestor.Parent then
				ancestor = ancestor.Parent
				local aName = ancestor.Name:lower()
				if aName:find("skill") or aName:find("mastery") or aName:find("hud") or 
				   aName:find("dragon") or aName:find("fury") or aName:find("combat") or 
				   aName:find("ability") or aName:find("stat") then
					inSkillsOrHud = true
					break
				end
			else
				break
			end
		end

		if inSkillsOrHud then return false end

		local parent = guiElement.Parent
		if parent then
			local pName = parent.Name:lower()
			if pName:find("health") or pName:find("energy") or pName:find("stat") or 
			   pName:find("hud") or pName:find("move") or pName:find("skill") or 
			   pName:find("requirement") or pName:find("fury") or pName:find("mastery") or
			   pName:find("level") or pName:find("z") or pName:find("x") or pName:find("c") or pName:find("v") or pName:find("f") then
				return false
			end

			-- التأكد أن الفاكهة مطلوبة للفتح
			return shouldConvertFruit(guiElement)
		end
	end
	return false
end

-- فحص فوري عند فتح أي فاكهة
local function scanShopNow()
	pcall(function()
		for _, guiElement in ipairs(playerGui:GetDescendants()) do
			if isShopPrice(guiElement) then
				convertToOwned(guiElement)
			end
		end
	end)
end

