local function makeGlow(parent, color, size, strength)
	local holder = make("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local layers = {}
	for i = 1, 5 do
		local s = 1 - (i - 1) * 0.16
		local f = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(s, s),
			BackgroundColor3 = color,
			BackgroundTransparency = 1 - (strength or 0.5) * 0.22,
			Parent = holder,
		})
		round(f)
		layers[i] = f
	end
	local api = {}
	function api.setColor(c, t)
		for _, l in ipairs(layers) do
			tween(l, t or 0.3, { BackgroundColor3 = c })
		end
	end
	return holder, api
end

local function makeOrb(fruit, size, parent)
	local orb = make("Frame", {
		Name = "Orb",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.white,
		Parent = parent,
	})
	round(orb)
	make("UIGradient", {
		Rotation = 125,
		Color = cseq({
			{ 0, fruit.Color:Lerp(C.white, 0.45) },
			{ 0.55, fruit.Color },
			{ 1, fruit.Color:Lerp(C.black, 0.6) },
		}),
		Parent = orb,
	})
	stroke(orb, RARITY[fruit.Rarity], math.max(1, size / 45), 0.15)
	if fruit.Image ~= "" then
		make("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.86, 0.86),
			BackgroundTransparency = 1,
			Image = fruit.Image,
			ScaleType = Enum.ScaleType.Fit,
			Parent = orb,
		})
	else
		make("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.53),
			Size = UDim2.fromScale(0.6, 0.6),
			Text = fruit.Glyph,
			TextScaled = true,
			Font = Enum.Font.GothamBold,
			TextColor3 = C.white,
			Parent = orb,
		})
	end
	local hl = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.34, 0.26),
		Size = UDim2.fromScale(0.36, 0.18),
		Rotation = -28,
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.5,
		Parent = orb,
	})
	round(hl)
	make("UIGradient", { Rotation = 90, Transparency = nseq({ { 0, 0 }, { 1, 1 } }), Parent = hl })
	return orb
end

local function makeButton(o)
	local b = make("TextButton", {
		AutoButtonColor = false,
		AnchorPoint = o.AnchorPoint or Vector2.new(0, 0),
		Position = o.Position or UDim2.new(),
		Size = o.Size,
		LayoutOrder = o.LayoutOrder or 0,
		Parent = o.Parent,
	})
	local fill = make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = o.Primary and C.white or C.panel2,
		ZIndex = 1,
		Parent = b,
	})
	corner(fill, o.Radius or 8)
	if o.Primary then
		make("UIGradient", { Color = o.Gradient or cseq({ { 0, C.cyan }, { 1, C.purple } }), Parent = fill })
	end
	local st = stroke(fill, o.StrokeColor or (o.Primary and C.cyan or Color3.fromRGB(95, 115, 180)), 1, 0.55)
	if o.Shine ~= false then
		addShine(b, o.Radius or 8, 2)
	end
	local lbl = make("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = o.Text or "",
		Font = o.Font or Enum.Font.GothamBold,
		TextSize = o.TextSize or 12,
		TextColor3 = o.TextColor or C.white,
		ZIndex = 3,
		Parent = b,
	})
	local sc = make("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
