selectFruit = function(fruit)
	if not fruit then
		return
	end
	local rc = RARITY[fruit.Rarity]
	local changed = state.selected ~= fruit
	state.selected = fruit
	searchInput.Text = fruit.Name
	hideSuggestions()
	if changed then
		local old = orbHolder:FindFirstChild("Orb")
		if old then
			old:Destroy()
		end
		makeOrb(fruit, 76, orbHolder)
		orbScale.Scale = 0.55
		tween(orbScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	previewName.Text = string.upper(fruit.Name)
	previewNameGrad.Color = cseq({ { 0, C.white }, { 0.5, rc:Lerp(C.white, 0.45) }, { 1, C.white } })
	rarityPill.set(string.upper(fruit.Rarity), rc)
	previewGlowApi.setColor(rc:Lerp(fruit.Color, 0.4), 0.4)
	previewParticles.recolor({ rc, fruit.Color, C.cyan })
