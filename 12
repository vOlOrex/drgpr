local cineToken = 0

local function spawnBolt(layer, x0, y0, x1, y1, color)
	local n = 7
	local dx, dy = x1 - x0, y1 - y0
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1 then
		return
	end
	local nx, ny = -dy / len, dx / len
	local pts = {}
	for i = 0, n do
		local a = i / n
		local j = (i == 0 or i == n) and 0 or (math.random() - 0.5) * len * 0.24
		pts[i + 1] = Vector2.new(x0 + dx * a + nx * j, y0 + dy * a + ny * j)
	end
	local segs = {}
	for i = 1, n do
		local p0, p1 = pts[i], pts[i + 1]
		local d = p1 - p0
		local mid = (p0 + p1) / 2
		local rot = math.deg(math.atan2(d.Y, d.X))
		for _, spec in ipairs({ { 8, 0.78, color }, { 2.5, 0, C.white:Lerp(color, 0.35) } }) do
			local seg = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(mid.X, mid.Y),
				Size = UDim2.fromOffset(d.Magnitude + 2, spec[1]),
				Rotation = rot,
				BackgroundColor3 = spec[3],
				BackgroundTransparency = spec[2],
				Parent = layer,
			})
			round(seg)
			table.insert(segs, seg)
		end
	end
	task.delay(0.06, function()
		for _, sg in ipairs(segs) do
			if sg.Parent then
				tween(sg, 0.22, { BackgroundTransparency = 1 })
			end
		end
	end)
	task.delay(0.35, function()
		for _, sg in ipairs(segs) do
			sg:Destroy()
		end
	end)
end

local function playUnlockCinematic(fruit, isAll)
	if state.cinePlaying or not alive then
		return
	end
	state.cinePlaying = true
	cineToken = cineToken + 1
	local token = cineToken
	local rc = RARITY[fruit.Rarity]
	local vp = viewport()
	local s = math.clamp(math.min(vp.X / 640, vp.Y / 470), 0.45, 1)
	local CXc, CYc = 300, 185

	local overlay = make("Frame", {
		Name = "UnlockCinematic",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.black,
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 60,
		Parent = gui,
	})
	local root = make("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1, Parent = overlay })
	local stage = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(600, 440),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local stageScale = make("UIScale", { Scale = s * 1.08, Parent = stage })
	local flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.white, BackgroundTransparency = 1, ZIndex = 5, Parent = overlay })

	local function finish()
		removeStepper("cineOrbit")
		removeStepper("cineTitle")
		if overlay.Parent then
			overlay:Destroy()
		end
		state.cinePlaying = false
	end
	local function w(t)
		task.wait(t)
		return alive and token == cineToken
	end

	local cyanCircle = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CXc, CYc),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = C.cyan,
		BackgroundTransparency = 0.9,
		ZIndex = 2,
		Parent = stage,
	})
	round(cyanCircle)
	local cyanStroke = stroke(cyanCircle, C.white, 3, 0)
	local cyanStrokeGrad = make("UIGradient", {
		Color = cseq({ { 0, C.cyan }, { 0.5, C.purple }, { 1, C.cyan } }),
		Transparency = nseq({ { 0, 0 }, { 0.25, 0.5 }, { 0.5, 0 }, { 0.75, 0.5 }, { 1, 0 } }),
		Parent = cyanStroke,
	})
	local goldGlow = makeGlow(stage, C.gold, 0, 0.9)
	goldGlow.Position = UDim2.fromOffset(CXc, CYc)
	goldGlow.ZIndex = 1

	local dots = {}
	for i = 1, 40 do
		local a = (i - 1) / 40 * math.pi * 2 - math.pi / 2
		local d = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(CXc + math.cos(a) * 142, CYc + math.sin(a) * 142),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = Color3.fromRGB(70, 85, 130),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = stage,
		})
		round(d)
		dots[i] = d
	end
	local pctLabel = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CXc, CYc + 165),
		Size = UDim2.fromOffset(300, 20),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = C.cyan,
		TextTransparency = 1,
		ZIndex = 3,
		Parent = stage,
	})

	local cOrbHolder = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CXc, CYc + 32),
		Size = UDim2.fromOffset(130, 130),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = stage,
	})
	local cOrbScale = make("UIScale", { Scale = 0, Parent = cOrbHolder })
	local cOrb = makeOrb(fruit, 130, cOrbHolder)
	local boltLayer = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 7, Parent = stage })

	local orbitAlpha, orbitTarget = 0, 0
	local orbit = {}
	for i = 1, 22 do
		local sz = math.random(3, 6)
		local f = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(sz, sz),
			BackgroundColor3 = (i % 3 == 0) and C.gold or ((i % 2 == 0) and C.cyan or C.purple),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = stage,
		})
		round(f)
		orbit[i] = { f = f, r = 82 + math.random() * 48, sp = 0.9 + math.random() * 1.1, a = math.random() * 6.28, tilt = 0.3 + math.random() * 0.25 }
	end
	addStepper("cineOrbit", function(dt, t)
		orbitAlpha = orbitAlpha + (orbitTarget - orbitAlpha) * math.min(1, dt * 3)
		local cx = cOrbHolder.Position.X.Offset
		local cy = cOrbHolder.Position.Y.Offset
		cOrb.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 2.2) * 5)
		cyanStrokeGrad.Rotation = (t * 90) % 360
		for _, p in ipairs(orbit) do
			p.a = p.a + p.sp * dt
			local sx, sy = math.cos(p.a), math.sin(p.a)
			p.f.Position = UDim2.fromOffset(cx + sx * p.r, cy + sy * p.r * p.tilt)
			p.f.ZIndex = sy > 0 and 8 or 2
			p.f.BackgroundTransparency = 1 - orbitAlpha * (0.5 + 0.5 * (sy * 0.5 + 0.5))
		end
	end, false)

	local title = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CXc, CYc + 165),
		Size = UDim2.fromOffset(760, 50),
		Text = isAll and "ALL PERMANENT FRUITS UNLOCKED!" or "PERMANENT FRUIT UNLOCKED!",
		Font = Enum.Font.GothamBlack,
		TextSize = isAll and 32 or 36,
		TextColor3 = C.white,
		TextTransparency = 1,
		ZIndex = 9,
		Parent = stage,
	})
	local titleG = make("UIGradient", {
		Color = cseq({ { 0, C.gold }, { 0.5, Color3.fromRGB(255, 250, 225) }, { 1, C.gold } }),
		Parent = title,
	})
	local titleStroke = make("UIStroke", { Color = Color3.fromRGB(120, 70, 0), Thickness = 2, Transparency = 1, Parent = title })
	local titleScale = make("UIScale", { Scale = 0.35, Parent = title })
	local subtitle = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(CXc, CYc + 200),
		Size = UDim2.fromOffset(600, 24),
		Text = isAll and "👑  EVERY FRUIT IN SHOP IS NOW (OWNED)" or (fruit.Glyph .. "  " .. string.upper(fruit.Name) .. "  ·  (OWNED)"),
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = rc:Lerp(C.white, 0.25),
		TextTransparency = 1,
		ZIndex = 9,
		Parent = stage,
	})
	addStepper("cineTitle", function(_, t)
		titleG.Offset = Vector2.new(math.sin(t * 1.5) * 0.4, 0)
	end, false)

	task.spawn(function()
		playSound("charge")
		tween(overlay, 0.6, { BackgroundTransparency = 0.3 })
		tween(stageScale, 3.2, { Scale = s }, Enum.EasingStyle.Sine)
		tween(cOrbScale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back)
		if not w(0.5) then return finish() end
		tween(cyanCircle, 0.8, { Size = UDim2.fromOffset(220, 220) })
		if not w(0.35) then return finish() end
		tween(cOrbHolder, 1.3, { Position = UDim2.fromOffset(CXc, CYc) }, Enum.EasingStyle.Sine)
		for i = 1, 6 do
			local a = math.random() * math.pi * 2
			local r0, r1 = 50, 120 + math.random() * 55
			spawnBolt(boltLayer, CXc + math.cos(a) * r0, CYc + math.sin(a) * r0, CXc + math.cos(a) * r1, CYc + math.sin(a) * r1, (i % 2 == 0) and C.purple or C.cyan)
			if not w(0.12) then return finish() end
		end
		orbitTarget = 1
		tween(goldGlow, 0.9, { Size = UDim2.fromOffset(300, 300) })
		if not w(0.3) then return finish() end
		for _, d in ipairs(dots) do
			tween(d, 0.25, { BackgroundTransparency = 0.45 })
		end
		tween(pctLabel, 0.25, { TextTransparency = 0 })
		for i, d in ipairs(dots) do
			local c = C.cyan:Lerp(C.gold, i / #dots)
			tween(d, 0.2, { BackgroundColor3 = c, BackgroundTransparency = 0, Size = UDim2.fromOffset(9, 9) }, Enum.EasingStyle.Back)
			pctLabel.Text = string.format("CHARGING  %d%%", math.floor(i / #dots * 100))
			pctLabel.TextColor3 = c
			if i % 10 == 0 then
				local a = math.random() * math.pi * 2
				spawnBolt(boltLayer, CXc + math.cos(a) * 50, CYc + math.sin(a) * 50, CXc + math.cos(a) * 140, CYc + math.sin(a) * 140, C.gold)
			end
			if not w(0.045) then return finish() end
		end
		playSound("success")
		tween(flash, 0.08, { BackgroundTransparency = 0.25 }, Enum.EasingStyle.Linear)
		if not w(0.09) then return finish() end
		tween(flash, 0.8, { BackgroundTransparency = 1 })
		for _, d in ipairs(dots) do
			tween(d, 0.4, { BackgroundTransparency = 1 })
		end
		tween(pctLabel, 0.2, { TextTransparency = 1 })
		cyanStroke.Thickness = 4
		tween(cyanCircle, 0.6, { Size = UDim2.fromOffset(245, 245), BackgroundColor3 = C.gold, BackgroundTransparency = 0.86 })
		cOrbScale.Scale = 1.18
		tween(cOrbScale, 0.6, { Scale = 1.05 }, Enum.EasingStyle.Back)
		tween(title, 0.5, { TextTransparency = 0 })
		tween(titleStroke, 0.5, { Transparency = 0.25 })
		tween(titleScale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back)
		if not w(0.25) then return finish() end
		tween(subtitle, 0.5, { TextTransparency = 0 })
		for i = 1, 18 do
			local a = math.random() * math.pi * 2
			local r = 75 + math.random() * 100
			local sp = make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(CXc, CYc),
				Size = UDim2.fromOffset(24, 24),
				Text = "✦",
				TextSize = 12 + math.random(0, 14),
				Font = Enum.Font.GothamBold,
				TextColor3 = (i % 3 == 0) and C.white or C.gold,
				ZIndex = 8,
				Parent = stage,
			})
			tween(sp, 0.9 + math.random() * 0.5, {
				Position = UDim2.fromOffset(CXc + math.cos(a) * r, CYc + math.sin(a) * r * 0.8),
				Rotation = math.random(-180, 180),
			})
			task.delay(0.8, function()
				if sp.Parent then
					tween(sp, 0.9, { TextTransparency = 1 })
				end
			end)
		end
		if not w(2.4) then return finish() end
		tween(stageScale, 1.0, { Scale = s * 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		tween(root, 0.9, { GroupTransparency = 1 })
		tween(overlay, 1.0, { BackgroundTransparency = 1 })
		if not w(1.0) then return finish() end
		finish()
	end)
end

-- فتح الفاكهة المختارة أو المكتوبة فقط
requestUnlock = function()
	if state.cinePlaying then
		return
	end

	-- إذا كتب المستخدم اسماً في خانة البحث ولم يضغط Enter، يتم التعرف عليه تلقائياً
	if norm(searchInput.Text) ~= "" then
		local typedFruit = resolveFruit(searchInput.Text)
		if typedFruit then
			selectFruit(typedFruit)
		else
			playSound("error")
			notify("Fruit not found", string.format('No fruit named "%s".', searchInput.Text))
			return
		end
	end

	if not state.selected then
		playSound("error")
		notify("No fruit selected", "Type or tap a fruit first.")
		return
	end

	-- تسجيل الفاكهة كمفتوحة وتحديث المتجر فوراً
	unlockedFruits[state.selected.Key] = true
	scanShopNow()
	notify("Unlocked!", state.selected.Name .. " is now (OWNED) in shop.", C.cyan)

	playUnlockCinematic(state.selected, false)
end

