local function pill(parent, text, color, size, position, anchor)
	local p = make("Frame", {
		AnchorPoint = anchor or Vector2.new(0, 0),
		Position = position,
		Size = size,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
