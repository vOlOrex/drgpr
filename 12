local clock = 0
local steppers = {}
local rotators = {}
local shines = {}

local function addStepper(key, fn, windowOnly)
	steppers[key] = { fn = fn, window = windowOnly }
end
local function removeStepper(key)
	steppers[key] = nil
end
local function addRotator(obj, speed)
	table.insert(rotators, { obj = obj, speed = speed })
end

local function addShine(parent, radius, zindex)
	local f = make("Frame", {
		Name = "Shine",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		ZIndex = zindex or 2,
		Parent = parent,
	})
	corner(f, radius or 8)
	local g = make("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = nseq({ { 0, 1 }, { 0.42, 1 }, { 0.5, 0.62 }, { 0.58, 1 }, { 1, 1 } }),
		Parent = f,
	})
	table.insert(shines, { grad = g, period = 3.2 + math.random() * 1.5, phase = math.random() * 3 })
	return f
end

bind(RunService.RenderStepped, function(dt)
	if not alive then
		return
	end
	clock = clock + dt
	local windowActive = state.open and not state.minimized
	if state.open then
		for i = #rotators, 1, -1 do
			local r = rotators[i]
			if not r.obj.Parent then
				table.remove(rotators, i)
			else
				r.obj.Rotation = (r.obj.Rotation + r.speed * dt) % 360
			end
		end
		for i = #shines, 1, -1 do
			local s = shines[i]
			if not s.grad.Parent then
				table.remove(shines, i)
			else
				local p = (clock + s.phase) % s.period
				if p < 0.9 then
					s.grad.Offset = Vector2.new(-1 + 2 * (p / 0.9), 0)
				else
					s.grad.Offset = Vector2.new(-1, 0)
				end
			end
		end
	end
	for key, s in pairs(steppers) do
		if windowActive or not s.window then
			local ok, err = pcall(s.fn, dt, clock)
			if not ok then
				steppers[key] = nil
				warn("[FruitVault] effect stopped:", key, err)
			end
		end
	end
end)

